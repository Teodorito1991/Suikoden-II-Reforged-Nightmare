<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Suikoden I and II HD Remaster</GamePath>
    <Version>1.40.0-party-revolution.1</Version>
    <AssemblyName>ReforgedNightmare</AssemblyName>
    <OutputPath>bin/$(Configuration)/$(Version)/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HallFirstContact)' == 'true'">
    <DefineConstants>$(DefineConstants);HALL_FIRST_CONTACT</DefineConstants>
    <Version>1.42.0-hall-recovery.2</Version>
    <OutputPath>bin/$(Configuration)/$(Version)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GamePath)\BepInEx\core\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GamePath)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GamePath)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ShareUI"><HintPath>$(GamePath)\BepInEx\interop\ShareUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GSD2"><HintPath>$(GamePath)\BepInEx\interop\GSD2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GamePath)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LitJson"><HintPath>$(GamePath)/BepInEx/interop/LitJson.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GSDShare"><HintPath>$(GamePath)\BepInEx\interop\GSDShare.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FrameWork"><HintPath>$(GamePath)\BepInEx\interop\FrameWork.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content/*.json" LogicalName="ReforgedContent.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GamePath)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(GamePath)\BepInEx\interop\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.UI"><HintPath>$(GamePath)\BepInEx\interop\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Unity.Addressables"><HintPath>$(GamePath)\BepInEx\interop\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(GamePath)\BepInEx\interop\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GamePath)\BepInEx\interop\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Reference Include="UnityEngine.UIModule"><HintPath>$(GamePath)/BepInEx/interop/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
<Reference Include="Unity.TextMeshPro"><HintPath>$(GamePath)/BepInEx/interop/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
<Reference Include="DOTween"><HintPath>$(GamePath)/BepInEx/interop/DOTween.dll</HintPath><Private>false</Private></Reference>
<Reference Include="DOTweenPro"><HintPath>$(GamePath)/BepInEx/interop/DOTweenPro.dll</HintPath><Private>false</Private></Reference>
<Reference Include="DOTweenPro.Scripts"><HintPath>$(GamePath)/BepInEx/interop/DOTweenPro.Scripts.dll</HintPath><Private>false</Private></Reference></ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)\BepInEx\interop\GSD2.dll')" Text="Run the installed BepInEx IL2CPP game once to generate interop/GSD2.dll; set -p:GamePath to the game directory." />
  </Target>
</Project>
